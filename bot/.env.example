# Copie ce fichier en .env et remplis-le (ne le commit JAMAIS).

# Token du bot : https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Token GitHub "fine-grained" : https://github.com/settings/personal-access-tokens
#   Repository access : seulement Labakadu37/Brawl-star-
#   Permissions       : Contents -> Read and write
GITHUB_TOKEN=

GITHUB_REPO=Labakadu37/Brawl-star-
STATUS_PATH=remote/status.json

# Ton ID Discord (clic droit sur ton profil -> Copier l'identifiant), plusieurs = separes par des virgules
OWNER_IDS=

# ID de ton serveur Discord : les commandes apparaissent instantanement (sinon jusqu'a 1h)
GUILD_ID=
